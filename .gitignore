# ==========================================
# Universal .gitignore for sih-2026
# (Full-stack Web, Python AI/Backend, Embedded Hardware & IoT)
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.credentials
credentials.json
serviceAccountKey.json

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (PyCharm, WebStorm, CLion, etc.)
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Sublime Text & TextMate
*.sublime-workspace
*.sublime-project
*.tmproj
*.tmproject

# Vim & Emacs
*.swp
*.swo
.*.sw[a-p]
[._]s[a-v][a-z]
[._]*.un~
Session.vim
#*#
.#*

# ------------------------------------------
# Node.js / TypeScript / Web (Next.js, Vite, etc.)
# ------------------------------------------
# Dependencies
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.*

# Package manager caches & locks
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/

# Build & Output
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.svelte-kit/
.turbo/
.cache/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Linter caches
.eslintcache
.stylelintcache
.prettiercache

# ------------------------------------------
# Python (FastAPI, Flask, AI/ML, PyTorch)
# ------------------------------------------
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Distributions & Packaging
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter Notebooks
.ipynb_checkpoints/

# ------------------------------------------
# Hardware, Embedded & C/C++ (Arduino, PlatformIO, ESP-IDF)
# ------------------------------------------
# Object files & Binaries
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.hex
*.elf
*.bin
*.eep
*.d
*.pdb
*.ilk

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.clangd/

# CMake & Make
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile.old

# Arduino
*.ino.cpp
*.ino.hex

# ------------------------------------------
# Logs, Temp Files & User Uploads
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Application uploads & runtime data
uploads/
tmp/
temp/

# Testing & Coverage
coverage/
.nyc_output/
htmlcov/
.coverage
.coverage.*

# Databases & Large binary model weights
*.sqlite
*.sqlite3
*.db
*.pt
*.pth
*.onnx
*.tflite
*.h5
