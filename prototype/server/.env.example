# FastAPI Application Settings
PROJECT_NAME="SIH2026 FastAPI Server"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENV="development"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins or list string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]

# Upload Directory for received camera images/files
UPLOAD_DIR="uploads"
